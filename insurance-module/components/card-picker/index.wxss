.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 76rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid #E4D8CE;
  border-radius: 8rpx;
  background: #FFFFFF;
  color: #2F2925;
  box-sizing: border-box;
}

.card-face {
  display: block;
  overflow: hidden;
  min-width: 0;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 29rpx;
  font-weight: 700;
}

.card-black .card-face { color: #2F2925; }
.card-red .card-face { color: #B84E43; }
.card-empty .card-face { color: #A7A099; font-size: 23rpx; font-weight: 400; }
.picker-chevron { flex: 0 0 auto; margin-left: 8rpx; color: #80656D; font-size: 25rpx; line-height: 1; }

.card-control { width: 100%; }
.card-strip { display: flex; align-items: center; min-height: 84rpx; gap: 8rpx; padding: 10rpx 12rpx; border: 1rpx solid #E4D8CE; border-radius: 8rpx; background: #FCF9F6; }
.mini-card { display: flex; width: 58rpx; height: 64rpx; box-sizing: border-box; flex: 0 0 58rpx; flex-direction: column; align-items: center; justify-content: center; border: 1rpx solid #E4D8CE; border-radius: 6rpx; background: #FFFFFF; font-size: 22rpx; font-weight: 700; line-height: 1.05; }
.mini-card.card-black { color: #2F2925; }.mini-card.card-red { color: #B84E43; }
.card-placeholder { flex: 1; color: #A7A099; font-size: 24rpx; }
.card-modal-mask { position: fixed; z-index: 1000; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; justify-content: center; box-sizing: border-box; background: rgba(41, 50, 53, 0.28); }
.card-modal { width: 100%; max-height: 88vh; box-sizing: border-box; padding: 26rpx 24rpx 20rpx; border-radius: 16rpx 16rpx 0 0; background: #FFFFFF; }
.card-modal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; }.card-modal-title { display: block; color: #2F2925; font-size: 34rpx; font-weight: 700; }.card-modal-count { display: block; margin-top: 5rpx; color: #6E6259; font-size: 22rpx; }.card-modal-close { width: 56rpx; height: 56rpx; margin: 0; padding: 0; border: 0; background: transparent; color: #6E6259; font-size: 42rpx; line-height: 52rpx; }
.card-grid-scroll { max-height: 58vh; }.card-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 10rpx; padding: 4rpx 0 12rpx; }.option-card { position: relative; display: flex; min-width: 0; height: 78rpx; box-sizing: border-box; flex-direction: column; align-items: center; justify-content: center; border: 1rpx solid #E4D8CE; border-radius: 7rpx; background: #FCF9F6; }.option-rank { font-size: 25rpx; font-weight: 700; line-height: 1; }.option-suit { margin-top: 3rpx; font-size: 22rpx; line-height: 1; }.option-card.card-black { color: #2F2925; }.option-card.card-red { color: #B84E43; }.option-card.option-selected { border: 2rpx solid #347258; background: #EEF5F0; color: #246648; }.option-check { position: absolute; top: 3rpx; right: 5rpx; color: #347258; font-size: 17rpx; font-weight: 700; }
.card-modal-actions { display: flex; gap: 10rpx; padding-top: 12rpx; border-top: 1rpx solid #F0E7DF; }.card-modal-action { flex: 1; min-width: 0; min-height: 76rpx; margin: 0; border-radius: 8rpx; font-size: 26rpx; font-weight: 700; line-height: 76rpx; }.card-action-clear { background: #F7F3EA; color: #8F631E; }.card-action-cancel { background: #FFFFFF; color: #6E6259; }.card-action-confirm { background: #347258; color: #FFFFFF; }
.option-card.option-disabled { opacity: .32; }
