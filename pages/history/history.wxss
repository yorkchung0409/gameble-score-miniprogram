.page { min-height: 100vh; box-sizing: border-box; padding: 34rpx 32rpx 60rpx; color: #2F2925; }.loading, .load-failure { padding: 260rpx 48rpx 0; color: #6E6259; text-align: center; }.load-failure text { display: block; font-size: 27rpx; }.retry-button { width: 240rpx; margin-top: 28rpx; border-radius: 8rpx; background: #5E6B73; color: #FFFFFF; font-size: 27rpx; }.page-title { font-size: 42rpx; font-weight: 700; }.segmented { display: flex; gap: 8rpx; margin-top: 28rpx; padding: 6rpx; border-radius: 8rpx; background: #F1E8E1; }.segment { flex: 1; padding: 17rpx 8rpx; border-radius: 6rpx; color: #6E6259; font-size: 27rpx; text-align: center; }.segment.selected { background: #FFFFFF; color: #5E6B73; font-weight: 700; box-shadow: 0 2rpx 8rpx rgba(77, 55, 44, 0.08); }.section-title { display: flex; justify-content: space-between; margin: 42rpx 0 18rpx; font-size: 36rpx; font-weight: 700; }.section-count { color: #6E6259; font-size: 27rpx; font-weight: 400; }.history-list { border-top: 1rpx solid #E8DED4; }.history-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; min-height: 142rpx; border-bottom: 1rpx solid #E8DED4; }.history-main { min-width: 0; }.history-name { display: block; overflow: hidden; font-size: 32rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }.history-code { display: block; margin-top: 7rpx; color: #5E6B73; font-size: 24rpx; letter-spacing: 1rpx; }.history-note { display: block; overflow: hidden; margin-top: 8rpx; color: #6E6259; font-size: 25rpx; text-overflow: ellipsis; white-space: nowrap; }.history-value { flex: 0 0 auto; font-size: 31rpx; }.room-state { font-size: 23rpx; }.room-state.active { color: #2E7D5B; }.room-state.archived { color: #8F631E; }.positive { color: #2E7D5B; font-weight: 700; }.negative { color: #B84E43; font-weight: 700; }.neutral { color: #6E6259; }.empty-state { padding: 34rpx 0 8rpx; border-top: 1rpx solid #E8DED4; color: #6E6259; font-size: 26rpx; text-align: center; }.load-more { width: 240rpx; margin: 24rpx auto 0; border-radius: 8rpx; background: #F1E8E1; color: #5E6B73; font-size: 26rpx; }
.retry-button, .load-more { border-radius: 10rpx; }
