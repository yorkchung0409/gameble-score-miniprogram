<view wx:if="{{loading}}" class="loading">加载历史记录...</view>
<view wx:elif="{{loadError}}" class="load-failure">
  <text>{{loadError}}</text>
  <button class="retry-button" bindtap="loadHistory">重新加载</button>
</view>
<view wx:else class="page">
  <view class="page-title">历史麻将房</view>
  <view class="section-title"><text>麻将房</text><text class="section-count">{{mahjongTotal}} 房</text></view>
  <view wx:if="{{mahjongRooms.length}}" class="history-list">
    <view wx:for="{{mahjongRooms}}" wx:key="roomCode" class="history-row" data-code="{{item.roomCode}}" bindtap="openMahjongRoom">
      <view class="history-main">
        <text class="history-name">房间 {{item.roomCode}}</text>
        <text class="history-note"><text class="room-state {{item.roomStateClass}}">{{item.roomState}}</text> · 最近活动 {{item.lastActivityDisplay}}</text>
      </view>
      <text class="{{item.netClass}} history-value">{{item.netDisplay}}</text>
    </view>
  </view>
  <view wx:else class="empty-state">还没有麻将房记录</view>
  <button wx:if="{{mahjongHasMore}}" class="load-more" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore}}">加载更多</button>
</view>
