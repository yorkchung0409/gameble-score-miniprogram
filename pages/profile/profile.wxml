<view wx:if="{{loading}}" class="loading">加载个人战绩...</view>

<view wx:elif="{{loadError}}" class="load-failure">
  <text>{{loadError}}</text>
  <button class="retry-button" bindtap="loadProfile">重新加载</button>
</view>

<view wx:elif="{{summary}}" class="page">
  <view wx:if="{{syncWarning}}" class="sync-warning">{{syncWarning}}</view>
  <view class="profile-header">
    <view>
      <text class="profile-name">{{needsNickname ? '设置昵称' : user.name}}</text>
      <text class="profile-caption">个人战绩</text>
    </view>
  </view>
  <view wx:if="{{needsNickname}}" class="profile-editor">
    <input type="nickname" value="{{nickname}}" bindinput="onNicknameInput" placeholder="输入昵称" class="input" maxlength="30" />
    <button class="save-button" loading="{{savingProfile}}" disabled="{{savingProfile}}" bindtap="saveProfile">保存昵称</button>
  </view>

  <view class="summary-band">
    <text class="summary-label">总输赢</text>
    <text class="summary-value {{summary.totalNetClass}}">{{summary.totalNetDisplay}}</text>
  </view>
  <view class="stat-grid">
    <view class="stat-cell">
      <text class="stat-label">扑克输赢</text>
      <text class="stat-value {{summary.pokerNetClass}}">{{summary.pokerNetDisplay}}</text>
      <text class="stat-note">{{summary.poker.gameCount}} 局 · {{summary.poker.trackedLedgerCount}} 本</text>
    </view>
    <view class="stat-cell">
      <text class="stat-label">麻将输赢</text>
      <text class="stat-value {{summary.mahjongNetClass}}">{{summary.mahjongNetDisplay}}</text>
      <text class="stat-note">赢 {{summary.mahjong.winTotal}} / 输 {{summary.mahjong.lossTotal}}</text>
    </view>
  </view>
  <view class="tea-row"><text>茶费支出</text><text>{{summary.teaFeeDisplay}}</text></view>

  <view class="section-title"><text>麻将对手战绩</text><view class="section-tools"><text class="section-count">{{summary.mahjong.opponentCount}} 人</text><text wx:if="{{summary.mahjong.opponentCount}}" class="section-action" bindtap="openOpponents">查看</text></view></view>

  <view class="section-title"><text>历史扑克账本</text><view class="section-tools"><text class="section-count">{{summary.poker.ledgerCount}} 本</text><text wx:if="{{pokerLedgers.length}}" class="section-action" data-type="poker" bindtap="openHistory">查看全部</text></view></view>
  <view wx:if="{{pokerLedgers.length}}" class="history-list">
    <view wx:for="{{pokerLedgers}}" wx:key="id" class="history-row" data-code="{{item.room.roomCode}}" bindtap="openPokerLedger">
      <view class="history-main">
        <text class="history-name">{{item.room.roomName}}</text>
        <text wx:if="{{item.selfPlayerId}}" class="history-note">本人 {{item.myGameCount}} 局</text>
        <text wx:else class="history-note">尚未设置本账本中的我</text>
      </view>
      <view class="history-side"><text class="{{item.netClass}}">{{item.netDisplay}}</text><text class="history-date">{{item.updatedDisplay}}</text></view>
    </view>
  </view>
  <view wx:else class="empty-state">还没有扑克账本</view>

  <view class="section-title"><text>历史麻将房</text><view class="section-tools"><text class="section-count">{{summary.mahjong.roomCount}} 房</text><text wx:if="{{mahjongRooms.length}}" class="section-action" data-type="mahjong" bindtap="openHistory">查看全部</text></view></view>
  <view wx:if="{{mahjongRooms.length}}" class="history-list">
    <view wx:for="{{mahjongRooms}}" wx:key="roomCode" class="history-row" data-code="{{item.roomCode}}" bindtap="openMahjongRoom">
      <view class="history-main">
        <text class="history-name">房间 {{item.roomCode}}</text>
        <text class="history-note"><text class="room-state {{item.roomStateClass}}">{{item.roomState}}</text> · {{item.lastActivityDisplay}}</text>
      </view>
      <text class="{{item.netClass}}">{{item.netDisplay}}</text>
    </view>
  </view>
  <view wx:else class="empty-state">还没有麻将房记录</view>
</view>
