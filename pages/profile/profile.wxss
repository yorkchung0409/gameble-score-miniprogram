.page { min-height: 100vh; box-sizing: border-box; padding: 42rpx 32rpx 210rpx; color: #222B26; }
.loading, .load-failure { padding: 260rpx 48rpx 0; color: #6B7A70; text-align: center; }.load-failure text { display: block; font-size: 27rpx; }
.retry-button { width: 240rpx; margin-top: 28rpx; border-radius: 8rpx; background: #1E7A46; color: #FFFFFF; font-size: 27rpx; }
.profile-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }.profile-name { display: block; font-size: 42rpx; font-weight: 700; }.profile-caption { display: block; margin-top: 8rpx; color: #6B7A70; font-size: 28rpx; }
.profile-editor { display: flex; gap: 14rpx; margin-bottom: 28rpx; }.input { flex: 1; min-width: 0; height: 88rpx; box-sizing: border-box; padding: 0 20rpx; border: 1rpx solid #DCE3DC; border-radius: 8rpx; background: #FFFFFF; font-size: 31rpx; }.save-button { flex: 0 0 166rpx; min-height: 88rpx; margin: 0; border-radius: 8rpx; background: #1E7A46; color: #FFFFFF; font-size: 29rpx; font-weight: 700; line-height: 88rpx; }
.summary-band { padding: 32rpx; border: 1rpx solid #D9EBDD; border-radius: 8rpx; background: #EAF4ED; }.summary-label, .stat-label, .stat-note, .history-note, .history-date, .section-count { color: #6B7A70; }.summary-label { display: block; font-size: 29rpx; }.summary-value { display: block; margin-top: 12rpx; font-size: 58rpx; font-weight: 700; line-height: 1.1; }
.stat-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; margin-top: 16rpx; }.stat-cell { min-width: 0; padding: 24rpx; border: 1rpx solid #E6EAE2; border-radius: 8rpx; background: #FFFFFF; }.stat-label { display: block; font-size: 27rpx; }.stat-value { display: block; overflow: hidden; margin-top: 10rpx; font-size: 35rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }.stat-note { display: block; overflow: hidden; margin-top: 10rpx; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.tea-row { display: flex; justify-content: space-between; margin-top: 18rpx; padding-bottom: 4rpx; color: #6B7A70; font-size: 28rpx; }.section-title { display: flex; justify-content: space-between; margin: 50rpx 0 18rpx; font-size: 36rpx; font-weight: 700; }.section-tools { display: flex; align-items: center; gap: 20rpx; }.section-count { font-size: 27rpx; font-weight: 400; }.section-action { color: #1E7A46; font-size: 26rpx; font-weight: 600; }
.history-list { border-top: 1rpx solid #E6EAE2; }.history-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; min-height: 132rpx; border-bottom: 1rpx solid #E6EAE2; }.history-main { min-width: 0; }.history-name { display: block; overflow: hidden; font-size: 32rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }.history-note { display: block; overflow: hidden; margin-top: 10rpx; font-size: 26rpx; text-overflow: ellipsis; white-space: nowrap; }.history-side { display: flex; flex: 0 0 auto; flex-direction: column; align-items: flex-end; gap: 8rpx; font-size: 31rpx; font-weight: 700; }.history-date { font-size: 24rpx; font-weight: 400; }
.room-state { font-size: 21rpx; }.room-state.active { color: #167443; }.room-state.archived { color: #9A7919; }.positive { color: #167443; font-weight: 700; }.negative { color: #C43C35; font-weight: 700; }.neutral { color: #6B7A70; }.empty-state { padding: 34rpx 0 8rpx; border-top: 1rpx solid #E6EAE2; color: #6B7A70; font-size: 26rpx; text-align: center; }
.overlay { position: fixed; z-index: 1000; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; background: rgba(34, 43, 38, 0.45); }.sheet { width: 100%; max-height: 74vh; box-sizing: border-box; padding: 28rpx 28rpx 48rpx; border-radius: 12rpx 12rpx 0 0; background: #FFFFFF; }.sheet-header { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }.sheet-title { font-size: 32rpx; font-weight: 700; }.close-button { width: 56rpx; height: 56rpx; margin: 0; padding: 0; background: transparent; color: #6B7A70; font-size: 46rpx; font-weight: 300; line-height: 52rpx; }.close-button::after { border: 0; }.record-list { max-height: 54vh; margin-top: 18rpx; border-top: 1rpx solid #E6EAE2; }.record-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; min-height: 102rpx; border-bottom: 1rpx solid #E6EAE2; font-size: 27rpx; }.record-room, .record-date { display: block; }.record-room { max-width: 360rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.record-date { margin-top: 8rpx; color: #6B7A70; font-size: 22rpx; }.record-result { display: flex; flex: 0 0 auto; flex-direction: column; align-items: flex-end; gap: 6rpx; }.record-result text:first-child { font-size: 24rpx; }.record-amount { color: #6B7A70; font-size: 25rpx; }.sheet-loading { padding: 48rpx 0; color: #6B7A70; font-size: 26rpx; text-align: center; }
