.page { min-height: 100vh; box-sizing: border-box; padding: 42rpx 32rpx 178rpx; color: #2F2925; }
.loading, .load-failure { padding: 260rpx 48rpx 0; color: #6E6259; text-align: center; }.load-failure text { display: block; font-size: 27rpx; }
.sync-warning { margin-bottom: 20rpx; padding: 14rpx 18rpx; border: 1rpx solid #E8D5AC; border-radius: 8rpx; background: #FAF2DF; color: #806644; font-size: 22rpx; line-height: 1.4; }
.retry-button { width: 240rpx; margin-top: 28rpx; border-radius: 8rpx; background: #5E6B73; color: #FFFFFF; font-size: 27rpx; }
.profile-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }.profile-name { display: block; font-size: 42rpx; font-weight: 700; }.profile-caption { display: block; margin-top: 8rpx; color: #6E6259; font-size: 28rpx; }
.profile-editor { display: flex; gap: 14rpx; margin-bottom: 28rpx; }.input { flex: 1; min-width: 0; height: 88rpx; box-sizing: border-box; padding: 0 20rpx; border: 1rpx solid #E4D8CE; border-radius: 8rpx; background: #FFFFFF; font-size: 31rpx; }.save-button { flex: 0 0 166rpx; min-height: 88rpx; margin: 0; border-radius: 8rpx; background: #5E6B73; color: #FFFFFF; font-size: 29rpx; font-weight: 700; line-height: 88rpx; }
.summary-band { padding: 32rpx; border: 1rpx solid #E7D8CE; border-radius: 8rpx; background: #F5ECE5; }.summary-label, .stat-label, .stat-note, .history-note, .history-date, .section-count { color: #6E6259; }.summary-label { display: block; font-size: 29rpx; }.summary-value { display: block; margin-top: 12rpx; font-size: 58rpx; font-weight: 700; line-height: 1.1; }
.stat-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; margin-top: 16rpx; }.stat-cell { min-width: 0; padding: 24rpx; border: 1rpx solid #E8DED4; border-radius: 8rpx; background: #FFFFFF; }.stat-label { display: block; font-size: 27rpx; }.stat-value { display: block; overflow: hidden; margin-top: 10rpx; font-size: 35rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }.stat-note { display: block; overflow: hidden; margin-top: 10rpx; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.tea-row { display: flex; justify-content: space-between; margin-top: 18rpx; padding-bottom: 4rpx; color: #6E6259; font-size: 28rpx; }.section-title { display: flex; justify-content: space-between; margin: 50rpx 0 18rpx; font-size: 36rpx; font-weight: 700; }.section-tools { display: flex; align-items: center; gap: 20rpx; }.section-count { font-size: 27rpx; font-weight: 400; }.section-action { color: #5E6B73; font-size: 26rpx; font-weight: 600; }
.history-list { border-top: 1rpx solid #E8DED4; }.history-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; min-height: 132rpx; border-bottom: 1rpx solid #E8DED4; }.history-main { min-width: 0; }.history-name { display: block; overflow: hidden; font-size: 32rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }.history-note { display: block; overflow: hidden; margin-top: 10rpx; font-size: 26rpx; text-overflow: ellipsis; white-space: nowrap; }.history-side { display: flex; flex: 0 0 auto; flex-direction: column; align-items: flex-end; gap: 8rpx; font-size: 31rpx; font-weight: 700; }.history-date { font-size: 24rpx; font-weight: 400; }
.room-state { font-size: 21rpx; }.room-state.active { color: #2E7D5B; }.room-state.archived { color: #8F631E; }.positive { color: #2E7D5B; font-weight: 700; }.negative { color: #B84E43; font-weight: 700; }.neutral { color: #6E6259; }.empty-state { padding: 34rpx 0 8rpx; border-top: 1rpx solid #E8DED4; color: #6E6259; font-size: 26rpx; text-align: center; }
.retry-button, .save-button { border-radius: 10rpx; }
