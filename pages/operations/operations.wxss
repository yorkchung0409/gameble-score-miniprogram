.page { min-height: 100vh; box-sizing: border-box; padding: 36rpx 32rpx 64rpx; color: #2F2925; }.loading, .load-failure { padding: 260rpx 48rpx 0; color: #6E6259; text-align: center; }.load-failure text { display: block; font-size: 27rpx; }.retry-button { width: 240rpx; margin-top: 28rpx; border-radius: 10rpx; background: #5E6B73; color: #FFFFFF; font-size: 27rpx; }.sync-warning { margin-bottom: 20rpx; padding: 14rpx 18rpx; border: 1rpx solid #E8D5AC; border-radius: 8rpx; background: #FAF2DF; color: #806644; font-size: 22rpx; line-height: 1.4; }.page-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 18rpx; }.page-title { font-size: 42rpx; font-weight: 700; }.updated-at { flex: 0 0 auto; color: #6E756F; font-size: 22rpx; }.section { margin-top: 44rpx; }.section-title { display: block; margin-bottom: 18rpx; font-size: 34rpx; font-weight: 700; }.metric-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; }.metric-grid.three-columns { grid-template-columns: repeat(3, minmax(0, 1fr)); }.metric { display: flex; min-width: 0; min-height: 146rpx; box-sizing: border-box; flex-direction: column; justify-content: space-between; padding: 22rpx 18rpx; border: 1rpx solid #E8DED4; border-radius: 8rpx; background: #FFFFFF; }.metric.mahjong { border-color: #CFE1D8; background: #F5F8F6; }.metric.poker { border-color: #E6D8D2; background: #FCF7F4; }.metric-value { display: block; overflow: hidden; color: #365E4D; font-size: 42rpx; font-weight: 700; line-height: 1.1; text-overflow: ellipsis; white-space: nowrap; }.metric-label { display: block; overflow: hidden; margin-top: 14rpx; color: #6E6259; font-size: 22rpx; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }.section-note { display: block; margin-top: 16rpx; color: #7A766F; font-size: 22rpx; line-height: 1.5; }
