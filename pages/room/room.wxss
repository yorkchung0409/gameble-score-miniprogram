.page { min-height: 100vh; box-sizing: border-box; padding: 30rpx 28rpx 70rpx; color: #2F2925; }
.state-page { min-height: 100vh; padding: 280rpx 40rpx 0; box-sizing: border-box; text-align: center; color: #6E6259; background: #FAF9F6; }
.error-text { display: block; margin-bottom: 28rpx; color: #B84E43; font-size: 28rpx; }
.room-header { width: 100%; display: flex; flex-wrap: nowrap; align-items: center; gap: 8rpx; margin-bottom: 24rpx; box-sizing: border-box; }
.exit-button::after, .mode-switch-action::after, .modal-close::after, .seat-action::after, .reverse-button::after, .primary-button::after, .confirm-button::after, .mode-option::after { border: 0; }
.room-title { flex: 0 0 auto; font-size: 32rpx; font-weight: 700; white-space: nowrap; }
.room-code { flex: 0 0 auto; color: #2F2925; font-family: monospace; font-size: 28rpx; font-weight: 700; white-space: nowrap; }
.mode-badge { flex: 0 0 auto; padding: 5rpx 10rpx; border-radius: 6rpx; background: #F7EEDF; color: #8A5F1E; font-size: 22rpx; white-space: nowrap; }
.mode-switch-action { flex: 0 0 auto; margin: 0; padding: 0 4rpx; background: transparent; color: #347258; font-size: 22rpx; line-height: 38rpx; }
.copy-hint { flex: 0 0 auto; color: #347258; font-size: 22rpx; }
.room-header-spacer { flex: 1 1 auto; min-width: 8rpx; }
.exit-button { flex: 0 0 auto; margin: 0; padding: 0 4rpx; background: transparent; color: #A84B45; font-size: 23rpx; line-height: 42rpx; }
.archive-label { flex: 0 0 auto; color: #8F631E; font-size: 23rpx; }
.sync-warning { margin: -8rpx 0 20rpx; padding: 14rpx 18rpx; border: 1rpx solid #E8D5AC; border-radius: 8rpx; background: #FAF2DF; color: #806644; font-size: 22rpx; line-height: 1.4; }
.panel { margin-bottom: 22rpx; padding: 26rpx; border: 1rpx solid #E8DED4; border-radius: 12rpx; background: #FFFFFF; }
.panel-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; font-size: 31rpx; font-weight: 700; }
.panel-help { color: #7A6E65; font-size: 22rpx; font-weight: 400; }
.member-panel { padding-right: 0; }
.member-scroll { width: 100%; height: 176rpx; white-space: nowrap; }
.member-list { display: inline-flex; align-items: stretch; gap: 12rpx; padding-right: 26rpx; }
.member-card { position: relative; flex: 0 0 120rpx; width: 120rpx; height: 176rpx; min-width: 120rpx; margin: 0; padding: 34rpx 6rpx 8rpx; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; border: 1rpx solid #E1E6E1; border-radius: 10rpx; background: #FFFFFF; box-shadow: 0 3rpx 10rpx rgba(77,55,44,.06); color: #2F2925; line-height: normal; }
.member-card::after { border: 0; }
.avatar-wrap { position: relative; width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; }
.avatar, .tea-avatar { width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #5E6B73; color: #FFFFFF; font-size: 26rpx; font-weight: 700; }
.my-avatar { border: 4rpx solid #347258; box-sizing: border-box; }
.me-tag { position: absolute; top: -7rpx; right: -12rpx; padding: 1rpx 6rpx; border-radius: 14rpx; background: #347258; color: #FFFFFF; font-size: 17rpx; }
.owner-tag { position: absolute; top: 0; left: 0; padding: 4rpx 7rpx; border-radius: 9rpx 0 8rpx 0; background: #E8F0EA; color: #2F6B5E; font-size: 16rpx; line-height: 24rpx; }
.member-name { width: 100%; margin-top: 4rpx; overflow: hidden; text-align: center; text-overflow: ellipsis; white-space: nowrap; font-size: 21rpx; line-height: 27rpx; }
.member-balance { width: 100%; margin-top: 0; overflow: hidden; color: #6E6259; font-family: monospace; font-size: 22rpx; line-height: 27rpx; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.positive { color: #2E7D5B; }.negative { color: #B84E43; }.tea-item { color: #8F631E; }.tea-avatar { background: #F7EBD0; border: 2rpx solid #D5B96E; box-sizing: border-box; padding: 10rpx; }.tea-avatar-icon { width: 42rpx; height: 38rpx; }.tea-balance { color: #8F631E; }
.invite-card { justify-content: center; padding: 12rpx 6rpx; background: #FCF9F6; }
.invite-icon { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 1rpx dashed #CDBDB2; border-radius: 50%; color: #7A6A5F; font-size: 42rpx; font-weight: 300; line-height: 60rpx; }
.invite-label { margin-top: 11rpx; color: #6D5F56; font-size: 20rpx; line-height: 28rpx; white-space: nowrap; }
.seat-panel { padding: 20rpx 14rpx 14rpx; }
.seat-board { position: relative; display: grid; grid-template-columns: repeat(3, 144rpx); grid-template-rows: repeat(3, 144rpx); justify-content: center; gap: 6rpx; width: 100%; }
.mahjong-table { z-index: 0; grid-column: 2; grid-row: 2; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 144rpx; height: 144rpx; box-sizing: border-box; border: 2rpx solid #C7D6C8; border-radius: 10rpx; background: #E8F0EA; box-shadow: inset 0 0 16rpx rgba(72,103,82,.10); color: #3F6B5E; }
.tea-fee-icon { width: 60rpx; height: 54rpx; padding: 0; box-sizing: border-box; }
.tea-fee-label { margin-top: 4rpx; color: #3F6B5E; font-size: 17rpx; font-weight: 600; }
.seat-card { z-index: 1; width: 144rpx; height: 144rpx; min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 7rpx 4rpx; box-sizing: border-box; border: 1rpx solid #E1E6E1; border-radius: 10rpx; background: #FFFFFF; box-shadow: 0 4rpx 12rpx rgba(77,55,44,.08); text-align: center; }
.available-seat { border-color: #C7D6C8; background: #FBFDFC; }
.seat-north { grid-column: 2; grid-row: 1; }.seat-east { grid-column: 3; grid-row: 2; }.seat-south { grid-column: 2; grid-row: 3; }.seat-west { grid-column: 1; grid-row: 2; }
.selected-seat { border: 3rpx solid #347258; box-shadow: 0 6rpx 18rpx rgba(52,114,88,.18); }
.seat-name { color: #527A64; font-size: 27rpx; font-weight: 700; }.empty-seat { margin: 6rpx 0; color: #7A6E65; font-size: 22rpx; }.seat-user { width: 100%; margin-top: 1rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; line-height: 1.2; font-size: 20rpx; font-weight: 600; }.seat-score { display: flex; flex-direction: column; align-items: center; margin-top: 2rpx; }.seat-score-value { margin-top: 0; color: #70645C; font-family: monospace; font-size: 22rpx; font-weight: 700; }
.seat-card .seat-action { min-width: 68rpx; height: 38rpx; margin: 5rpx 0 0; padding: 0 7rpx; border-radius: 6rpx; font-size: 19rpx; line-height: 38rpx; }.sit-seat { background: #347258; color: #FFFFFF; }.transfer-seat { background: #F7EEDF; color: #8A5F1E; }.leave-seat { background: #F8E9E6; color: #9E3D33; }
.score-panel { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; padding: 24rpx 26rpx; border-radius: 10rpx; background: #F7EEDF; }.score-label, .balance-state text:first-child { display: block; color: #8C7255; font-size: 23rpx; }.score-value { display: block; margin-top: 6rpx; color: #8F631E; font-family: monospace; font-size: 34rpx; font-weight: 700; }.balance-state { text-align: right; }.balance-state text:last-child { display: block; margin-top: 6rpx; font-size: 28rpx; font-weight: 700; }.balanced text:last-child { color: #246648; }.unbalanced text:last-child { color: #9E3D33; }
.archive-notice { margin-bottom: 22rpx; padding: 22rpx; border: 1rpx solid #E8D5AC; border-radius: 8rpx; background: #FAF2DF; color: #806644; font-size: 24rpx; }
.transaction-panel { padding-bottom: 10rpx; }.transaction-list { height: 480rpx; overflow: hidden; }.transaction-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 18rpx 0; border-top: 1rpx solid #F0E7DF; }.reversal-row { opacity: .65; }.transaction-main { flex: 1; min-width: 0; }.transaction-time { margin-bottom: 6rpx; color: #7A6E65; font-size: 21rpx; }.reversal-tag { margin-left: 10rpx; padding: 2rpx 7rpx; border-radius: 5rpx; background: #8F631E; color: #FFFFFF; font-size: 18rpx; }.payer { color: #B84E43; font-size: 26rpx; }.arrow { margin: 0 10rpx; color: #7A6E65; }.payee { color: #2E7D5B; font-size: 26rpx; }.tea-fee-detail { display: block; margin-top: 5rpx; color: #8F631E; font-size: 21rpx; }.remark { display: block; margin-top: 5rpx; overflow: hidden; color: #7A6E65; text-overflow: ellipsis; white-space: nowrap; font-size: 21rpx; }.transaction-side { display: flex; align-items: center; gap: 12rpx; }.transaction-amount { color: #2F2925; font-family: monospace; font-size: 26rpx; font-weight: 700; }.reverse-button { margin: 0; padding: 0 8rpx; background: transparent; color: #6E6259; font-size: 21rpx; line-height: 40rpx; }.empty-transactions { padding: 32rpx 0; color: #7A6E65; text-align: center; font-size: 24rpx; }
.inline-load-more { width: 240rpx; margin: 18rpx auto 8rpx; border-radius: 8rpx; background: #F1E8E1; color: #347258; font-size: 24rpx; line-height: 64rpx; }
.modal-mask { position: fixed; z-index: 1000; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 40rpx 28rpx; box-sizing: border-box; background: rgba(41, 50, 53, 0.28); }.modal { width: 100%; max-width: 650rpx; box-sizing: border-box; padding: 30rpx 28rpx; border-radius: 14rpx; background: #FFFFFF; }.mode-modal { padding-bottom: 22rpx; }.modal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }.modal-title { color: #2F2925; font-size: 34rpx; font-weight: 700; }.modal-close { width: 52rpx; height: 52rpx; margin: 0; padding: 0; background: transparent; color: #6E6259; font-size: 40rpx; line-height: 48rpx; }.transfer-route { display: flex; align-items: center; justify-content: center; gap: 12rpx; margin-bottom: 26rpx; }.route-target { display: flex; flex-direction: column; align-items: center; }.route-avatar { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #FFFFFF; font-size: 27rpx; font-weight: 700; }.my-route { background: #347258; }.target-route { background: #8F631E; }.route-name { max-width: 132rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #2F2925; font-size: 22rpx; }.route-arrow { color: #6E6259; font-size: 32rpx; }.modal-input { width: 100%; height: 88rpx; box-sizing: border-box; margin-bottom: 16rpx; padding: 0 20rpx; border: 1rpx solid #E4D8CE; border-radius: 8rpx; color: #2F2925; font-size: 28rpx; }.amount-input { text-align: center; }.confirm-button { width: 100%; height: 88rpx; margin: 6rpx 0 0; border-radius: 8rpx; background: #347258; color: #FFFFFF; font-size: 30rpx; font-weight: 700; line-height: 88rpx; }.mode-option { display: flex; flex-direction: column; align-items: flex-start; width: 100%; margin: 0 0 14rpx; padding: 20rpx; border: 1rpx solid #E4D8CE; border-radius: 8rpx; background: #FFFFFF; color: #2F2925; text-align: left; }.mode-option-title { font-size: 28rpx; font-weight: 700; }.mode-option-desc { margin-top: 6rpx; color: #6E6259; font-size: 22rpx; }.primary-button { width: 230rpx; height: 78rpx; margin: 0 auto; border-radius: 8rpx; background: #347258; color: #FFFFFF; font-size: 28rpx; line-height: 78rpx; }
.tea-fee-rule-action { margin: 0; padding: 0 4rpx; border: 0; background: transparent; color: #347258; font-size: 22rpx; line-height: 38rpx; }
.tea-fee-rule-action::after { border: 0; }
.confirm-button { border-radius: 10rpx; }
.mode-option, .primary-button { border-radius: 10rpx; }
.tea-fee-rule-modal { max-height: 86vh; overflow-y: auto; }
.rule-switch-row, .rule-rate-head { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.rule-rate-head { position: relative; justify-content: center; min-height: 50rpx; }
.rule-rate-head .rule-label { position: absolute; left: 0; }
.rule-switch-row { padding: 10rpx 0 22rpx; border-bottom: 1rpx solid #F0E7DF; }
.rule-label { color: #2F2925; font-size: 27rpx; font-weight: 700; }
.rule-desc { display: block; margin-top: 6rpx; color: #7A6E65; font-size: 21rpx; font-weight: 400; }
.rule-fields { padding-top: 22rpx; }
.rule-mode-list { display: flex; gap: 12rpx; margin: 12rpx 0 22rpx; }
.rule-mode-option { flex: 1; min-width: 0; margin: 0; padding: 15rpx 10rpx; border: 1rpx solid #E4D8CE; border-radius: 9rpx; background: #FFFFFF; color: #2F2925; font-size: 24rpx; font-weight: 700; line-height: 1.25; }
.rule-mode-option::after, .rate-preset::after { border: 0; }
.rule-mode-option text { display: block; margin-top: 6rpx; color: #7A6E65; font-size: 20rpx; font-weight: 400; }
.rule-mode-selected { border-color: #347258; background: #EEF5F0; color: #246648; }
.rule-mode-disabled { opacity: .55; }
.rule-input { height: 78rpx; margin: 12rpx 0 20rpx; }
.rate-input-wrap { display: flex; align-items: center; justify-content: flex-end; gap: 6rpx; }
.rate-input { width: 132rpx; height: 50rpx; box-sizing: border-box; padding: 0 10rpx; border: 1rpx solid #D8E0DA; border-radius: 8rpx; background: #FFFFFF; color: #2F2925; font-family: monospace; font-size: 26rpx; line-height: 50rpx; text-align: center; }
.rate-suffix { color: #347258; font-size: 28rpx; font-weight: 700; }
.rate-presets { display: flex; gap: 12rpx; margin-top: 20rpx; }
.rate-preset { flex: 1; margin: 0; padding: 10rpx 0; border: 1rpx solid #E4D8CE; border-radius: 8rpx; background: #FFFFFF; color: #6E6259; font-size: 23rpx; line-height: 1.2; }
