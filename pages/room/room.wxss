.rule-summary { display: block; margin-top: 18rpx; padding: 14rpx 16rpx; border-radius: 8rpx; background: #F7F3EA; color: #806644; font-size: 21rpx; line-height: 1.45; }
.rule-save-button { margin-top: 24rpx; }
.tea-item-auto { border-color: #D8C79A; background: #FFFDF5; }
.tea-fee-rule-summary { display: flex; align-items: center; min-height: 54rpx; margin: 0 0 2rpx; padding: 0 4rpx; color: #806644; font-size: 21rpx; line-height: 54rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
