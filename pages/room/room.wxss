.page { min-height: 100vh; box-sizing: border-box; padding: 30rpx 28rpx 70rpx; color: #222B26; }
.state-page { min-height: 100vh; padding: 280rpx 40rpx 0; box-sizing: border-box; text-align: center; color: #6B7A70; background: #F4F6F1; }
.error-text { display: block; margin-bottom: 28rpx; color: #B13B36; font-size: 28rpx; }
.room-header { display: flex; align-items: flex-start; gap: 16rpx; margin-bottom: 28rpx; }
.back-button { flex: 0 0 58rpx; width: 58rpx; height: 58rpx; margin: 0; padding: 0; border: 1rpx solid #DCE3DC; border-radius: 50%; background: #FFFFFF; color: #222B26; font-size: 46rpx; line-height: 48rpx; }
.back-button::after, .exit-button::after, .text-action::after, .modal-close::after, .seat-action::after, .reverse-button::after, .primary-button::after, .confirm-button::after, .mode-option::after { border: 0; }
.room-heading { flex: 1; min-width: 0; }
.heading-line { display: flex; align-items: center; gap: 10rpx; }
.room-title { max-width: 360rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 38rpx; font-weight: 700; }
.mode-badge { padding: 5rpx 10rpx; border-radius: 6rpx; background: #F6F0DE; color: #967A20; font-size: 22rpx; white-space: nowrap; }
.code-line { display: flex; align-items: center; gap: 8rpx; margin-top: 8rpx; color: #6B7A70; font-size: 25rpx; }
.code { color: #222B26; font-family: monospace; }
.copy-hint { color: #1E7A46; }
.exit-button { flex: 0 0 auto; margin: 6rpx 0 0; padding: 0 12rpx; background: transparent; color: #A0443E; font-size: 25rpx; line-height: 46rpx; }
.archive-label { margin-top: 8rpx; color: #9A7919; font-size: 24rpx; }
.panel { margin-bottom: 22rpx; padding: 26rpx; border: 1rpx solid #E6EAE2; border-radius: 12rpx; background: #FFFFFF; }
.panel-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; font-size: 31rpx; font-weight: 700; }
.panel-help { color: #8A958D; font-size: 22rpx; font-weight: 400; }
.text-action { margin: 0; padding: 0; background: transparent; color: #1E7A46; font-size: 24rpx; line-height: 40rpx; }
.member-grid { display: flex; flex-wrap: wrap; gap: 22rpx 26rpx; }
.member-item { width: 102rpx; display: flex; flex-direction: column; align-items: center; }
.avatar-wrap { position: relative; }
.avatar, .tea-avatar { width: 76rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #7FB3E0; color: #FFFFFF; font-size: 33rpx; font-weight: 700; }
.my-avatar { border: 4rpx solid #1E7A46; box-sizing: border-box; }
.me-tag { position: absolute; top: -8rpx; right: -16rpx; padding: 2rpx 7rpx; border-radius: 16rpx; background: #1E7A46; color: #FFFFFF; font-size: 19rpx; }
.member-name { width: 100%; margin-top: 8rpx; overflow: hidden; text-align: center; text-overflow: ellipsis; white-space: nowrap; font-size: 24rpx; }
.member-balance { margin-top: 4rpx; color: #68756D; font-family: monospace; font-size: 24rpx; }
.positive { color: #168447; }.negative { color: #C3443C; }.tea-item { color: #9A7919; }.tea-avatar { background: #B08D1E; font-size: 26rpx; }.tea-balance { color: #9A7919; }
.seat-panel { padding: 22rpx 18rpx 18rpx; }
.seat-board { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(132rpx, .82fr) minmax(0, 1fr); grid-template-rows: repeat(3, 128rpx); gap: 8rpx; width: 100%; }
.mahjong-table { grid-column: 2; grid-row: 2; display: flex; align-items: center; justify-content: center; justify-self: center; align-self: center; width: 118rpx; height: 108rpx; min-width: 0; border: 2rpx solid #146D43; border-radius: 12rpx; background: #16845C; box-shadow: inset 0 0 20rpx rgba(0,0,0,.12); color: #FFFFFF; }
.table-mark { width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #FFFFFF; color: #16845C; font-size: 30rpx; font-weight: 700; }
.seat-card { min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 8rpx 4rpx; box-sizing: border-box; border: 1rpx solid #E1E6E1; border-radius: 10rpx; background: #FFFFFF; box-shadow: 0 4rpx 12rpx rgba(30,40,34,.08); text-align: center; }
.seat-north { grid-column: 2; grid-row: 1; }.seat-east { grid-column: 3; grid-row: 2; }.seat-south { grid-column: 2; grid-row: 3; }.seat-west { grid-column: 1; grid-row: 2; }
.selected-seat { border: 3rpx solid #1E7A46; box-shadow: 0 6rpx 18rpx rgba(30,122,70,.16); }
.seat-name { color: #16845C; font-size: 27rpx; font-weight: 700; }.empty-seat { margin: 8rpx 0; color: #98A39B; font-size: 22rpx; }.seat-user { width: 100%; margin-top: 1rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 20rpx; font-weight: 600; }.seat-score { display: flex; flex-direction: column; align-items: center; margin-top: 2rpx; }.seat-score-value { margin-top: 0; color: #59665E; font-family: monospace; font-size: 22rpx; font-weight: 700; }
.seat-card .seat-action { min-width: 68rpx; height: 38rpx; margin: 5rpx 0 0; padding: 0 7rpx; border-radius: 6rpx; font-size: 19rpx; line-height: 38rpx; }.sit-seat { background: #1E7A46; color: #FFFFFF; }.transfer-seat { background: #F6F0DE; color: #967A20; }.leave-seat { background: #FBEDEC; color: #A0443E; }
.score-panel { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; padding: 24rpx 26rpx; border-radius: 10rpx; background: #F6F0DE; }.score-label, .balance-state text:first-child { display: block; color: #8A7A45; font-size: 23rpx; }.score-value { display: block; margin-top: 6rpx; color: #A57B1D; font-family: monospace; font-size: 34rpx; font-weight: 700; }.balance-state { text-align: right; }.balance-state text:last-child { display: block; margin-top: 6rpx; font-size: 28rpx; font-weight: 700; }.balanced text:last-child { color: #168447; }.unbalanced text:last-child { color: #C3443C; }
.record-action { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; padding: 25rpx 28rpx; border-radius: 10rpx; background: #1E7A46; color: #FFFFFF; font-size: 30rpx; font-weight: 700; }.record-arrow { font-size: 42rpx; font-weight: 300; line-height: 28rpx; }.archive-notice { margin-bottom: 22rpx; padding: 22rpx; border: 1rpx solid #E7DCAE; border-radius: 8rpx; background: #FBF8EA; color: #776525; font-size: 24rpx; }
.transaction-panel { padding-bottom: 10rpx; }.transaction-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 18rpx 0; border-top: 1rpx solid #EEF1ED; }.reversal-row { opacity: .65; }.transaction-main { flex: 1; min-width: 0; }.transaction-time { margin-bottom: 6rpx; color: #8A958D; font-size: 21rpx; }.reversal-tag { margin-left: 10rpx; padding: 2rpx 7rpx; border-radius: 5rpx; background: #B08D1E; color: #FFFFFF; font-size: 18rpx; }.payer { color: #C3443C; font-size: 26rpx; }.arrow { margin: 0 10rpx; color: #8A958D; }.payee { color: #168447; font-size: 26rpx; }.remark { display: block; margin-top: 5rpx; overflow: hidden; color: #8A958D; text-overflow: ellipsis; white-space: nowrap; font-size: 21rpx; }.transaction-side { display: flex; align-items: center; gap: 12rpx; }.transaction-amount { color: #222B26; font-family: monospace; font-size: 26rpx; font-weight: 700; }.reverse-button { margin: 0; padding: 0 8rpx; background: transparent; color: #6B7A70; font-size: 21rpx; line-height: 40rpx; }.empty-transactions { padding: 32rpx 0; color: #8A958D; text-align: center; font-size: 24rpx; }
.modal-mask { position: fixed; z-index: 1000; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 40rpx 28rpx; box-sizing: border-box; background: rgba(22,31,25,.5); }.modal { width: 100%; max-width: 650rpx; box-sizing: border-box; padding: 30rpx 28rpx; border-radius: 14rpx; background: #FFFFFF; }.mode-modal { padding-bottom: 22rpx; }.modal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }.modal-title { color: #222B26; font-size: 34rpx; font-weight: 700; }.modal-close { width: 52rpx; height: 52rpx; margin: 0; padding: 0; background: transparent; color: #6B7A70; font-size: 40rpx; line-height: 48rpx; }.transfer-route { display: flex; align-items: center; justify-content: center; gap: 12rpx; margin-bottom: 26rpx; }.route-target { display: flex; flex-direction: column; align-items: center; }.route-avatar { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #FFFFFF; font-size: 27rpx; font-weight: 700; }.my-route { background: #1E7A46; }.target-route { background: #B08D1E; }.route-name { max-width: 132rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #222B26; font-size: 22rpx; }.route-arrow { color: #6B7A70; font-size: 32rpx; }.modal-input { width: 100%; height: 88rpx; box-sizing: border-box; margin-bottom: 16rpx; padding: 0 20rpx; border: 1rpx solid #DCE3DC; border-radius: 8rpx; color: #222B26; font-size: 28rpx; }.amount-input { text-align: center; }.confirm-button { width: 100%; height: 88rpx; margin: 6rpx 0 0; border-radius: 8rpx; background: #1E7A46; color: #FFFFFF; font-size: 30rpx; font-weight: 700; line-height: 88rpx; }.mode-option { display: flex; flex-direction: column; align-items: flex-start; width: 100%; margin: 0 0 14rpx; padding: 20rpx; border: 1rpx solid #DCE3DC; border-radius: 8rpx; background: #FFFFFF; color: #222B26; text-align: left; }.mode-option-title { font-size: 28rpx; font-weight: 700; }.mode-option-desc { margin-top: 6rpx; color: #6B7A70; font-size: 22rpx; }.primary-button { width: 230rpx; height: 78rpx; margin: 0 auto; border-radius: 8rpx; background: #1E7A46; color: #FFFFFF; font-size: 28rpx; line-height: 78rpx; }
