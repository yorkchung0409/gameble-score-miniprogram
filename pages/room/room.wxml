<view wx:if="{{loading}}" class="state-page"><text>加载中...</text></view>
<view wx:elif="{{loadError}}" class="state-page"><text class="error-text">{{loadError}}</text><button class="primary-button" bindtap="retryLoadRoom">重新加载</button></view>
<view wx:elif="{{detail}}" class="page">
  <view class="room-header">
    <text class="room-title">房间</text>
    <text class="room-code" bindtap="copyRoomCode">{{roomCode}}</text>
    <text class="copy-hint" bindtap="copyRoomCode">复制</text>
    <text class="mode-badge">{{modeLabel}}</text>
    <button wx:if="{{isOwner && !isArchived}}" class="mode-switch-action" disabled="{{switchingMode}}" bindtap="openModeDialog">切换</button>
    <view class="room-header-spacer"></view>
    <button class="exit-button" wx:if="{{!isArchived}}" loading="{{exitingRoom}}" disabled="{{exitingRoom}}" bindtap="exitRoom">退出</button>
    <text class="archive-label" wx:else>已归档</text>
  </view>

  <view wx:if="{{syncWarning}}" class="sync-warning">{{syncWarning}}</view>

  <view wx:if="{{isFreeMode}}" class="panel member-panel">
    <view class="panel-heading"><text>成员</text><button wx:if="{{isOwner && !isArchived}}" class="tea-fee-rule-action" bindtap="openTeaFeeRule">茶费规则 ›</button></view>
    <scroll-view class="member-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="member-list">
        <view wx:for="{{memberRows}}" wx:key="userId" class="member-card" data-id="{{item.userId}}" bindtap="openTransfer">
          <text wx:if="{{item.isOwner}}" class="owner-tag">房主</text>
          <view class="avatar-wrap"><view class="avatar {{item.isMe ? 'my-avatar' : ''}}" style="background-color: {{item.avatarColor}};">{{item.initial}}</view><text wx:if="{{item.isMe}}" class="me-tag">我</text></view>
          <text class="member-name">{{item.userName}}</text><text wx:if="{{isArchived && item.leftAt}}" class="member-left">已离开</text>
          <text class="member-balance {{item.balance > 0 ? 'positive' : item.balance < 0 ? 'negative' : ''}}">{{item.balanceDisplay}}</text>
        </view>
        <view class="member-card tea-item {{teaFeeRule.enabled ? 'tea-item-auto' : ''}}" data-id="tea_fee" bindtap="openTeaFeeTransfer">
          <view class="avatar-wrap"><view class="avatar tea-avatar"><image class="tea-avatar-icon" src="/assets/tea-fee.svg" mode="aspectFit" /></view></view>
          <text class="member-name">茶水费</text>
          <text class="member-balance tea-balance">{{detail.stats.teaFeeTotal}}</text>
        </view>
        <button wx:if="{{!isArchived}}" class="member-card invite-card" open-type="share" aria-label="邀请好友加入房间">
          <view class="invite-icon">+</view>
          <text class="invite-label">邀请好友</text>
        </button>
      </view>
    </scroll-view>
  </view>

  <view wx:else class="panel seat-panel">
    <view class="panel-heading"><text>方位座位</text><button wx:if="{{isOwner && !isArchived}}" class="tea-fee-rule-action" bindtap="openTeaFeeRule">茶费规则 ›</button></view>
    <view class="seat-board">
      <view class="mahjong-table" bindtap="openTeaFeeTransfer" aria-label="支付茶水费"><image class="tea-fee-icon" src="/assets/tea-fee.svg" mode="aspectFit" /><text class="tea-fee-label">茶水费</text></view>
      <view wx:for="{{seatCards}}" wx:key="seatIndex" class="seat-card seat-{{item.position}} {{item.isMe ? 'selected-seat' : ''}} {{!item.occupied && !isArchived && !isFreeMode ? 'available-seat' : ''}}" data-index="{{item.seatIndex}}" bindtap="onSeatTap">
        <text class="seat-name">{{item.seatName}}</text>
        <text wx:if="{{item.occupied}}" class="seat-user">{{item.userName}}{{item.isMe ? '（我）' : ''}}</text>
        <view wx:if="{{item.occupied}}" class="seat-score"><text class="seat-score-value {{item.balance > 0 ? 'positive' : item.balance < 0 ? 'negative' : ''}}">{{item.balanceDisplay}}</text></view>
        <view wx:else class="empty-seat">空位</view>
        <button wx:if="{{item.occupied && item.isMe}}" class="seat-action leave-seat" loading="{{leavingSeat}}" disabled="{{leavingSeat}}" catchtap="leaveSeat" aria-label="离座">离座</button>
        <button wx:elif="{{item.occupied && currentUserSeated && !item.isMe}}" class="seat-action transfer-seat" data-id="{{item.userId}}" catchtap="openTransfer" aria-label="转账">转账</button>
      </view>
    </view>
  </view>

  <view class="score-panel">
    <view><text class="score-label">总流水</text><text class="score-value">¥{{detail.stats.totalTurnover}}</text></view>
    <view class="balance-state {{detail.stats.balanceCheck === 'balanced' ? 'balanced' : 'unbalanced'}}"><text>账目</text><text>{{detail.stats.balanceCheck === 'balanced' ? '已平衡' : '不平衡'}}</text></view>
  </view>

  <view wx:if="{{isArchived}}" class="archive-notice">该房间已归档，仅可查看历史积分和流水。</view>

  <view class="panel transaction-panel">
    <view class="panel-heading"><text>转账流水</text><text class="panel-help">{{isFreeMode ? '点击成员头像转账' : '入座后可转账'}}</text></view>
    <view wx:if="{{teaFeeRule.enabled}}" class="tea-fee-rule-summary"><text wx:if="{{teaFeeRule.mode === 'threshold'}}">自动抽水：满 ¥{{teaFeeRule.thresholdAmount}} 抽 ¥{{teaFeeRule.feeAmount}} · 支持手动茶水费</text><text wx:else>自动抽水：{{teaFeeRule.ratePercent}}% · 不向上取整 · 支持手动茶水费</text></view>
    <scroll-view wx:if="{{detail.transactions.length}}" class="transaction-list" scroll-y enhanced show-scrollbar="{{false}}">
      <view wx:for="{{detail.transactions}}" wx:key="id" class="transaction-row {{item.isReversal ? 'reversal-row' : ''}}">
        <view class="transaction-main"><view class="transaction-time">{{item.timeDisplay}}<text wx:if="{{item.isReversal}}" class="reversal-tag">冲正</text></view><view><text class="payer">{{item.payerName}}</text><text class="arrow">→</text><text class="payee">{{item.payeeDisplay}}</text></view><text wx:if="{{item.teaFeeDisplay}}" class="tea-fee-detail">茶水费 ¥{{item.teaFeeDisplay}}</text><text wx:if="{{item.remark}}" class="remark">备注：{{item.remark}}</text></view>
        <view class="transaction-side"><text class="transaction-amount">¥{{item.amountDisplay}}</text><button wx:if="{{item.canReverse}}" class="reverse-button" loading="{{reversingTransactionId === item.id}}" disabled="{{reversingTransactionId}}" data-id="{{item.id}}" bindtap="reverseTransaction">冲正</button></view>
      </view>
      <button wx:if="{{transactionsHasMore}}" class="inline-load-more" loading="{{loadingMoreTransactions}}" disabled="{{loadingMoreTransactions}}" bindtap="loadMoreTransactions">查看更多流水</button>
    </scroll-view>
    <view wx:else class="empty-transactions">还没有转账记录</view>
  </view>
</view>

<view wx:if="{{transferOpen}}" class="modal-mask" bindtap="closeTransfer">
  <view class="modal" catchtap="preventModalClose">
    <view class="modal-header"><text class="modal-title">记一笔</text><button class="modal-close" bindtap="closeTransfer">×</button></view>
    <view class="transfer-route"><view class="route-target"><view class="route-avatar my-route" style="background-color: {{currentUserColor}};">{{currentUserInitial}}</view><text class="route-name">{{currentUserName || '我'}}</text></view><view style="align-self: flex-start; height: 64rpx; display: flex; align-items: center;"><text class="route-arrow">→</text></view><picker range="{{payeeOptions}}" range-key="name" value="{{payeeIndex}}" bindchange="onPayeeChange"><view class="route-target"><view wx:if="{{transferPayeeType === 'tea_fee'}}" class="route-avatar target-route tea-route-avatar" style="background-color: #F7F0D9; border: 2rpx solid #D9C98E; box-sizing: border-box;"><image class="route-tea-icon" src="/assets/tea-fee.svg" mode="aspectFit" style="width: 52rpx; height: 48rpx;" /></view><view wx:else class="route-avatar target-route" style="background-color: {{transferPayeeColor}};">{{transferPayeeInitial}}</view><text class="route-name">{{transferPayeeName}}</text></view></picker></view>
    <input class="modal-input amount-input" type="digit" value="{{amount}}" focus="{{amountInputFocus}}" cursor-spacing="24" bindinput="onAmountInput" placeholder="输入金额" />
    <input class="modal-input" value="{{remark}}" bindinput="onRemarkInput" placeholder="备注（选填）" maxlength="100" />
    <button class="confirm-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitTransfer">确认转账</button>
  </view>
</view>

<view wx:if="{{modeDialogOpen}}" class="modal-mask" bindtap="closeModeDialog">
  <view class="modal mode-modal" catchtap="preventModalClose"><view class="modal-header"><text class="modal-title">房间模式</text><button class="modal-close" disabled="{{switchingMode}}" bindtap="closeModeDialog">×</button></view><button class="mode-option" disabled="{{switchingMode}}" data-mode="free" bindtap="switchMode"><text class="mode-option-title">普通模式</text><text class="mode-option-desc">进入房间即可转账</text></button><button class="mode-option" disabled="{{switchingMode}}" data-mode="seated" bindtap="switchMode"><text class="mode-option-title">坐下模式</text><text class="mode-option-desc">入座后才能转账，适合固定四家</text></button></view>
</view>

<view wx:if="{{teaFeeRuleOpen}}" class="modal-mask" bindtap="closeTeaFeeRule">
  <view class="modal tea-fee-rule-modal" catchtap="preventModalClose">
    <view class="modal-header"><text class="modal-title">茶水费规则</text><button class="modal-close" disabled="{{savingTeaFeeRule}}" bindtap="closeTeaFeeRule">×</button></view>
    <view class="rule-switch-row"><view><text class="rule-label">自动茶水费</text><text class="rule-desc">每笔玩家结算转账独立计算</text></view><switch checked="{{teaFeeRuleDraft.enabled}}" color="#347258" bindchange="onTeaFeeEnabledChange" /></view>
    <view wx:if="{{teaFeeRuleDraft.enabled}}" class="rule-fields">
      <text class="rule-label">抽水模式</text>
      <view class="rule-mode-list"><button class="rule-mode-option {{teaFeeRuleDraft.mode === 'percentage' ? 'rule-mode-selected' : ''}}" data-mode="percentage" bindtap="selectTeaFeeMode">百分比抽水<text>按百分比抽水，不取整</text></button><button class="rule-mode-option {{teaFeeRuleDraft.mode === 'threshold' ? 'rule-mode-selected' : ''}}" data-mode="threshold" bindtap="selectTeaFeeMode">满额抽水<text>满X抽Y</text></button></view>
      <block wx:if="{{teaFeeRuleDraft.mode === 'percentage'}}">
        <view class="rule-rate-head"><text class="rule-label">抽成比例</text><view class="rate-input-wrap"><input class="rate-input" type="number" value="{{teaFeeRuleDraft.ratePercent}}" maxlength="3" bindinput="onTeaFeeRateInput" placeholder="0" /><text class="rate-suffix">%</text></view></view>
        <view class="rate-presets"><button data-rate="5" class="rate-preset {{teaFeeRuleDraft.ratePercent === 5 ? 'rate-preset-selected' : ''}}" bindtap="setTeaFeeRate">5%</button><button data-rate="10" class="rate-preset {{teaFeeRuleDraft.ratePercent === 10 ? 'rate-preset-selected' : ''}}" bindtap="setTeaFeeRate">10%</button><button data-rate="20" class="rate-preset {{teaFeeRuleDraft.ratePercent === 20 ? 'rate-preset-selected' : ''}}" bindtap="setTeaFeeRate">20%</button></view>
        <text class="rule-summary">按转账金额的 {{teaFeeRuleDraft.ratePercent}}% 抽水；不会向上取整。</text>
      </block>
      <block wx:else>
        <text class="rule-label">满额规则</text>
        <view class="threshold-fee-row"><text class="threshold-word">满</text><input class="threshold-fee-input" type="digit" value="{{teaFeeRuleDraft.thresholdAmount}}" bindinput="onTeaFeeThresholdInput" placeholder="金额" /><text class="threshold-word">抽</text><input class="threshold-fee-input" type="digit" value="{{teaFeeRuleDraft.feeAmount}}" bindinput="onTeaFeeAmountInput" placeholder="金额" /></view>
        <text class="rule-summary">满 ¥{{teaFeeRuleDraft.thresholdAmount}} 抽 ¥{{teaFeeRuleDraft.feeAmount}}；每达到一次满额，就再抽一次。</text>
      </block>
    </view>
    <button class="confirm-button rule-save-button" loading="{{savingTeaFeeRule}}" disabled="{{savingTeaFeeRule}}" bindtap="saveTeaFeeRule">保存规则</button>
  </view>
</view>
