.page { min-height: 100vh; box-sizing: border-box; padding: 36rpx 32rpx 70rpx; color: #2F2925; }
.loading, .load-failure { padding: 260rpx 48rpx 0; color: #6E6259; text-align: center; }
.sync-warning { margin-bottom: 20rpx; padding: 14rpx 18rpx; border: 1rpx solid #E8D5AC; border-radius: 8rpx; background: #FAF2DF; color: #806644; font-size: 22rpx; line-height: 1.4; }
.load-failure text { display: block; font-size: 27rpx; }
.retry-button { width: 240rpx; margin-top: 28rpx; border-radius: 8rpx; background: #347258; color: #FFFFFF; font-size: 27rpx; }
.page-heading { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 24rpx; }
.page-title { font-size: 40rpx; font-weight: 700; }
.page-count { color: #6E6259; font-size: 27rpx; }
.opponent-list { border-top: 1rpx solid #E8DED4; }
.opponent-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; min-height: 142rpx; border-bottom: 1rpx solid #E8DED4; }
.opponent-main { flex: 1; min-width: 0; }
.opponent-name { display: block; overflow: hidden; font-size: 32rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.opponent-note { display: block; overflow: hidden; margin-top: 9rpx; color: #6E6259; font-size: 25rpx; text-overflow: ellipsis; white-space: nowrap; }
.opponent-side { display: flex; flex: 0 0 auto; flex-direction: column; align-items: flex-end; gap: 8rpx; }
.opponent-net { font-size: 31rpx; font-weight: 700; }
.opponent-date { color: #6E6259; font-size: 24rpx; }
.positive { color: #2E7D5B; }
.negative { color: #B84E43; }
.neutral { color: #6E6259; }
.empty-state { padding: 80rpx 0; border-top: 1rpx solid #E8DED4; color: #6E6259; font-size: 27rpx; text-align: center; }
.load-more { width: 240rpx; margin: 24rpx auto 0; border-radius: 8rpx; background: #F1E8E1; color: #347258; font-size: 25rpx; }
.retry-button, .load-more { border-radius: 10rpx; }
