.page { padding: 32rpx; }
.loading { padding-top: 240rpx; text-align: center; color: #6B7A70; }
.header { display: flex; align-items: center; gap: 20rpx; margin: 16rpx 0 36rpx; }
.avatar { width: 76rpx; height: 76rpx; border-radius: 50%; background: #1E7A46; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; }
.name { font-size: 36rpx; font-weight: 600; }
.card { margin-bottom: 24rpx; padding: 28rpx; background: #fff; border: 1rpx solid #E6EAE2; border-radius: 16rpx; }
.label { display: block; margin-bottom: 20rpx; font-weight: 600; }
.input { height: 84rpx; box-sizing: border-box; padding: 0 20rpx; margin-bottom: 20rpx; border: 1rpx solid #DCE3DC; border-radius: 10rpx; }
.primary, .secondary { font-weight: 600; }
.primary { background: #1E7A46; color: #fff; }
.secondary { background: #E8ECE6; color: #222B26; }
