.page { min-height: 100vh; box-sizing: border-box; padding: 36rpx 32rpx 72rpx; color: #222B26; }
.page-toolbar { display: flex; justify-content: flex-end; height: 56rpx; margin-bottom: 18rpx; }
.guide-button, .guide-close { display: flex; justify-content: center; align-items: center; padding: 0; margin: 0; }
.guide-button::after, .guide-close::after { border: 0; }
.guide-button { width: 56rpx; height: 56rpx; border: 1rpx solid #C8D4C9; border-radius: 50%; background: #FFFFFF; color: #1E7A46; font-size: 34rpx; font-weight: 700; line-height: 56rpx; }
.section-heading { display: flex; justify-content: space-between; align-items: baseline; margin: 0 0 18rpx; font-size: 32rpx; font-weight: 700; }
.section-heading.compact { margin-top: 42rpx; }
.form-block, .profile-block { padding: 28rpx; border: 1rpx solid #E6EAE2; border-radius: 8rpx; background: #FFFFFF; }
.profile-block { margin-bottom: 42rpx; }
.block-title { display: block; margin-bottom: 20rpx; font-size: 30rpx; font-weight: 700; }
.input { height: 84rpx; box-sizing: border-box; margin-bottom: 18rpx; padding: 0 20rpx; border: 1rpx solid #DCE3DC; border-radius: 8rpx; font-size: 28rpx; background: #FFFFFF; }
.code-input { text-transform: uppercase; letter-spacing: 0; }
.primary-button, .secondary-button { margin: 0; border-radius: 8rpx; font-size: 29rpx; font-weight: 700; }
.primary-button { background: #1E7A46; color: #FFFFFF; }
.secondary-button { background: #E8ECE6; color: #222B26; }
.guide-mask { position: fixed; z-index: 1000; top: 0; right: 0; bottom: 0; left: 0; display: flex; justify-content: center; align-items: center; padding: 48rpx; box-sizing: border-box; background: rgba(22, 31, 25, 0.5); }
.guide-modal { width: 100%; max-height: 78vh; overflow: hidden; border: 1rpx solid #E6EAE2; border-radius: 8rpx; background: #FFFFFF; }
.guide-header { display: flex; justify-content: space-between; align-items: center; min-height: 94rpx; padding: 0 28rpx; border-bottom: 1rpx solid #E6EAE2; }
.guide-dialog-title { color: #222B26; font-size: 32rpx; font-weight: 700; }
.guide-close { width: 56rpx; height: 56rpx; background: transparent; color: #6B7A70; font-size: 48rpx; font-weight: 300; line-height: 52rpx; }
.guide-body { max-height: 62vh; padding: 28rpx; box-sizing: border-box; }
.guide-section { margin-bottom: 30rpx; }
.guide-section-last { margin-bottom: 0; }
.guide-section-title { display: block; margin-bottom: 12rpx; color: #1E7A46; font-size: 28rpx; font-weight: 700; }
.guide-section-title-common { color: #9A7919; }
.guide-item { display: flex; align-items: flex-start; gap: 10rpx; margin-top: 10rpx; color: #222B26; font-size: 26rpx; line-height: 1.55; }
.guide-bullet { flex: 0 0 14rpx; color: #B08D1E; font-size: 30rpx; line-height: 1.35; }
.guide-bullet-common { color: #B08D1E; }
