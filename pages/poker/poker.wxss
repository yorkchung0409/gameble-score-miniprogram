.page { min-height: 100vh; box-sizing: border-box; padding: 32rpx 28rpx 76rpx; color: #2F2925; }
.loading, .load-failure { padding: 260rpx 48rpx 0; color: #6E6259; text-align: center; }
.load-failure text { display: block; font-size: 27rpx; }.retry-button { width: 240rpx; margin-top: 28rpx; border-radius: 8rpx; background: #80656D; color: #FFFFFF; font-size: 27rpx; }
.room-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 24rpx; padding: 8rpx 0 30rpx; }.room-header > view { flex: 1; min-width: 0; }
.room-name { display: block; font-size: 42rpx; font-weight: 700; line-height: 1.25; }
.room-code { display: block; margin-top: 10rpx; color: #6E6259; font-family: monospace; font-size: 25rpx; }
.header-button, .text-button, .danger-button { margin: 0; padding: 0 14rpx; font-size: 25rpx; line-height: 52rpx; background: transparent; }.header-button { flex: 0 0 auto; }
.header-button, .text-button { color: #80656D; }
.danger-button { color: #B84E43; }
.sync-warning { margin: -10rpx 0 22rpx; padding: 14rpx 18rpx; border: 1rpx solid #E8D5AC; border-radius: 8rpx; background: #FAF2DF; color: #806644; font-size: 22rpx; line-height: 1.4; }
.stats-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; padding: 20rpx; background: #F5ECE5; border: 1rpx solid #E7D8CE; border-radius: 8rpx; }
.stat-item { min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.stat-label { color: #6E6259; font-size: 23rpx; }
.stat-value { overflow: hidden; color: #80656D; font-size: 33rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.section-title-row { display: flex; align-items: center; justify-content: space-between; margin: 40rpx 0 18rpx; }
.section-title { font-size: 32rpx; font-weight: 700; }
.player-list { display: flex; flex-wrap: wrap; gap: 12rpx; }
.player-chip { display: flex; align-items: center; gap: 10rpx; min-width: 0; padding: 10rpx 16rpx 10rpx 10rpx; border: 1rpx solid #E8DED4; border-radius: 999rpx; background: #FFFFFF; font-size: 26rpx; }.player-chip text { max-width: 180rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.player-avatar { width: 42rpx; height: 42rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #5E6B73; color: #FFFFFF; font-size: 23rpx; font-weight: 700; }
.empty-line, .empty-state { padding: 30rpx 0; color: #6E6259; font-size: 26rpx; text-align: center; }
.manager-panel { margin-top: 18rpx; padding: 22rpx; border: 1rpx solid #E8DED4; border-radius: 8rpx; background: #FFFFFF; }
.manager-add { display: flex; gap: 14rpx; align-items: center; }
.input { height: 78rpx; box-sizing: border-box; padding: 0 18rpx; border: 1rpx solid #E4D8CE; border-radius: 8rpx; background: #FFFFFF; font-size: 27rpx; }
.manager-add .input { flex: 1; min-width: 0; }
.add-button { flex: 0 0 130rpx; margin: 0; border-radius: 8rpx; background: #80656D; color: #FFFFFF; font-size: 26rpx; font-weight: 700; }
.manager-row { display: flex; align-items: center; justify-content: space-between; min-width: 0; min-height: 78rpx; border-top: 1rpx solid #F0E7DF; font-size: 27rpx; }.manager-row > text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.manager-row:first-of-type { margin-top: 18rpx; }
.record-button { margin: 40rpx 0 0; border-radius: 8rpx; background: #80656D; color: #FFFFFF; font-size: 30rpx; font-weight: 700; }
.record-button[disabled] { background: #E8DED4; color: #6B5F57; }
.games-heading { margin-bottom: 12rpx; }
.leaderboard-heading { margin-bottom: 12rpx; }
.leaderboard-list { border-top: 1rpx solid #E8DED4; }
.leaderboard-row { display: flex; align-items: center; justify-content: space-between; min-height: 104rpx; border-bottom: 1rpx solid #E8DED4; font-size: 28rpx; font-weight: 700; }
.leaderboard-main { display: flex; align-items: center; min-width: 0; gap: 16rpx; }.leaderboard-main > view { min-width: 0; }.leaderboard-rank { width: 34rpx; color: #8F631E; font-size: 25rpx; text-align: center; }.leaderboard-name, .leaderboard-note { display: block; }.leaderboard-name { overflow: hidden; font-size: 27rpx; text-overflow: ellipsis; white-space: nowrap; }.leaderboard-note { margin-top: 7rpx; color: #6E6259; font-size: 21rpx; font-weight: 400; }
.game-list { border-top: 1rpx solid #E8DED4; }
.load-more-games { width: 240rpx; margin: 24rpx auto 0; border-radius: 8rpx; background: #F1E8E1; color: #80656D; font-size: 25rpx; }
.game-item { border-bottom: 1rpx solid #E8DED4; background: #FFFFFF; }
.game-summary { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 118rpx; }.game-summary > view:first-child { min-width: 0; }
.game-date { display: block; font-size: 29rpx; font-weight: 700; }
.game-subtitle { display: block; margin-top: 8rpx; color: #6E6259; font-size: 23rpx; }
.balance-state { flex: 0 0 auto; padding: 7rpx 12rpx; border-radius: 4rpx; font-size: 22rpx; }
.balanced, .balance-state.balanced { color: #246648; background: #F5ECE5; }
.unbalanced, .balance-state.unbalanced { color: #9E3D33; background: #F8E9E6; }
.game-detail { padding: 0 0 22rpx; }
.game-totals { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10rpx 16rpx; padding: 16rpx; background: #FAF5F1; color: #6E6259; font-size: 23rpx; }
.game-table-head, .game-table-row { display: grid; grid-template-columns: 1.45fr 1fr 1fr 1.1fr; column-gap: 10rpx; align-items: center; min-height: 62rpx; font-size: 22rpx; text-align: right; }
.game-table-head { color: #6E6259; }
.game-table-row { border-top: 1rpx solid #F0E7DF; font-size: 23rpx; }
.game-table-head text:first-child, .game-table-row text:first-child { padding-left: 4rpx; text-align: left; }
.game-table-row text { min-width: 0; overflow-wrap: anywhere; }.player-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.positive { color: #2E7D5B; font-weight: 700; }.negative { color: #B84E43; font-weight: 700; }.neutral { color: #6E6259; }
.game-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12rpx; min-height: 62rpx; font-size: 23rpx; }
.game-actions { display: flex; align-items: center; }
.overlay { position: fixed; z-index: 1000; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; background: rgba(41, 50, 53, 0.28); }
.sheet { width: 100%; box-sizing: border-box; padding: 34rpx 28rpx 56rpx; background: #FFFFFF; border-radius: 12rpx 12rpx 0 0; }
.sheet-title { display: block; margin-bottom: 26rpx; font-size: 34rpx; font-weight: 700; }
.field-label { display: block; margin: 24rpx 0 10rpx; color: #6E6259; font-size: 24rpx; }.identity-picker { height: 78rpx; box-sizing: border-box; padding: 22rpx 18rpx; border: 1rpx solid #E4D8CE; border-radius: 8rpx; font-size: 27rpx; }
.sheet-actions { display: flex; gap: 18rpx; margin-top: 28rpx; }
.sheet-actions button { flex: 1; margin: 0; border-radius: 8rpx; font-size: 28rpx; font-weight: 700; }
.sheet-cancel { background: #F1E8E1; color: #2F2925; }.sheet-confirm { background: #80656D; color: #FFFFFF; }
.game-editor { max-height: 88vh; overflow: hidden; }
.sheet-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 18rpx; }
.sheet-heading .sheet-title { margin-bottom: 24rpx; }.sheet-note { color: #6E6259; font-size: 22rpx; }
.date-picker { box-sizing: border-box; height: 78rpx; padding: 22rpx 18rpx; border: 1rpx solid #E4D8CE; border-radius: 8rpx; color: #2F2925; font-size: 27rpx; }
.add-game-player { display: flex; align-items: center; justify-content: space-between; height: 78rpx; box-sizing: border-box; margin-top: 16rpx; padding: 22rpx 18rpx; border: 1rpx solid #E7D8CE; border-radius: 8rpx; background: #F5ECE5; color: #80656D; font-size: 27rpx; font-weight: 700; }
.picker-caret { color: #6E6259; font-size: 22rpx; font-weight: 400; }
.player-picker-menu { max-height: 260rpx; margin-top: 10rpx; border: 1rpx solid #E4D8CE; border-radius: 8rpx; background: #FFFFFF; overflow: hidden; }
.player-picker-option { display: flex; align-items: center; gap: 14rpx; min-height: 78rpx; box-sizing: border-box; padding: 0 18rpx; border-bottom: 1rpx solid #F0E7DF; color: #2F2925; font-size: 27rpx; }
.player-picker-option:last-child { border-bottom: 0; }
.player-picker-option:active { background: #F5ECE5; }
.player-picker-avatar { display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; border-radius: 50%; background: #5E6B73; color: #FFFFFF; font-size: 23rpx; font-weight: 700; }
.no-game-players { padding: 26rpx 0 12rpx; color: #6E6259; text-align: center; font-size: 24rpx; }
.player-editor-list { max-height: 46vh; margin-top: 20rpx; }
.editor-row { display: flex; align-items: center; gap: 12rpx; padding: 16rpx 2rpx; border-bottom: 1rpx solid #F0E7DF; }
.editor-fields { flex: 1; min-width: 0; }.editor-name { display: block; margin-bottom: 10rpx; font-size: 27rpx; font-weight: 600; }
.amount-inputs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }.small-input { height: 66rpx; min-width: 0; box-sizing: border-box; padding: 0 14rpx; border: 1rpx solid #E4D8CE; border-radius: 6rpx; font-size: 24rpx; }.input-placeholder { color: #A7B0A8; }
.remove-game-player { flex: 0 0 auto; margin: 0; padding: 0 8rpx; background: transparent; color: #A84B45; font-size: 22rpx; line-height: 48rpx; }
.retry-button, .add-button, .record-button, .sheet-actions button, .load-more-games { border-radius: 10rpx; }
